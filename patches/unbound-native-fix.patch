+static bool runtimeHasUnboundNative(jsi::Runtime &runtime)
+{
+    try
+    {
+        if (runtime.global().hasProperty(runtime, "UnboundNative"))
+        {
+            return true;
+        }
+        // Fallback script check (covers cases where hasProperty is flaky)
+        const char *check =
+            "!!(typeof globalThis!=='undefined'&&globalThis.UnboundNative)"
+            "||!!(typeof global!=='undefined'&&global.UnboundNative)"
+            "||!!(typeof window!=='undefined'&&window.UnboundNative);";
+        jsi::Value result = [JSI evaluateSource:[NSString stringWithUTF8String:check]
+                                            tag:@"unbound:native-check"
+                                        runtime:runtime];
+        return [JSI toBool:result runtime:runtime fallback:NO];
+    }
+    catch (...)
+    {
+        return false;
+    }
+}
